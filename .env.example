# ==============================================================================
# AeroMesh / llama-cluster Environment Configuration
# ==============================================================================

# Master Coordinator Host & Control Port
LLAMA_CLUSTER_HOST=0.0.0.0
LLAMA_CLUSTER_PORT=8080

# RPC Node Communication Secret Token
LLAMA_CLUSTER_SECRET=super_secret_aeromesh_token_2026

# Directory Paths (Relative to Repository Root)
LLAMA_CPP_DIR=./llama.cpp
MODEL_DIR=./models
DEFAULT_MODEL=Qwen2.5-32B-Instruct-Q4_K_M.gguf

# Optional: HuggingFace API Token (for gated GGUF downloads)
# Obtain from: https://huggingface.co/settings/tokens
HF_TOKEN=hf_your_huggingface_token_here

# AeroMesh Telemetry & Health Monitoring
TELEMETRY_INTERVAL_MS=200
THERMAL_THROTTLE_TEMP_C=85.0
MAX_VRAM_USAGE_PERCENT=90.0

# Byzantine Tensor Validator (Canary Trap Protocol)
CANARY_SAMPLE_RATE=0.05
CANARY_WARNING_THRESHOLD=0.003
CANARY_EVICTION_THRESHOLD=0.005

# Toxiproxy Chaos Testing Engine Config
TOXIPROXY_HOST=127.0.0.1
TOXIPROXY_PORT=8474

# System Log Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
